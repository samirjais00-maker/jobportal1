@model JobPortal.Models.OrganizationViewModel

@{
    ViewData["Title"] = "Edit";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}
<div class="breadcrumbs">
    <div class="breadcrumbs-inner">
        <div class="row m-0">
            <div class="col-sm-4">
                <div class="page-header float-left">
                    <div class="page-title">
                        <h1>Organization</h1>
                    </div>
                </div>
            </div>
            <div class="col-sm-8">
                <div class="page-header float-right">
                    <div class="page-title">
                        <ol class="breadcrumb text-right">
                            <li><a href="@Url.Action("Index", "Organization")">Organization</a></li>
                            <li class="active">Edit</li>
                        </ol>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>



<div class="content">
    <div class="animated fadeIn">


        <div class="row">
            <div class="col-lg-8">
                <div class="card">
                    <div class="card-header">
                        <strong class="card-title">Edit Organization</strong>
                    </div>
                    <div class="card-body">
                        <!-- Credit Card -->
                        <div id="pay-invoice">
                            <div class="card-body">
                                @* <form action="#" method="post" novalidate="novalidate"> *@
                                <form asp-action="Edit" enctype="multipart/form-data">
                                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                                    <input asp-for="OrgId" class="form-control" hidden />
                                    <div class="form-group">
                                        <label asp-for="OrgName" class="control-label mb-1"></label>
                                        <input asp-for="OrgName" class="form-control" />
                                        <span asp-validation-for="OrgName" class="text-danger"></span>
                                    </div>
                                    <div class="form-group has-success">
                                        <label asp-for="OrgAddress" class="control-label mb-1"></label>
                                        <input asp-for="OrgAddress" class="form-control" />
                                        <span asp-validation-for="OrgAddress" class="text-danger"></span>
                                    </div>
                                    <div class="form-group">
                                        <label asp-for="OrgContact" class="control-label mb-1"></label>
                                        <input asp-for="OrgContact" class="form-control" />
                                        <span asp-validation-for="OrgContact" class="text-danger"></span>
                                    </div>
                                    <div class="form-group">
                                        <label asp-for="OrgEmail" class="control-label mb-1"></label>
                                        <input asp-for="OrgEmail" class="form-control" />
                                        <span asp-validation-for="OrgEmail" class="text-danger"></span>
                                    </div>
                                    <div class="form-group">
                                        <label asp-for="OrgLocation" class="control-label mb-1"></label>
                                        <input asp-for="OrgLocation" class="form-control" />
                                        <span asp-validation-for="OrgLocation" class="text-danger"></span>
                                    </div>
                                    <div class="form-group">
                                        <label asp-for="OrgImage" class="control-label"></label>
                                        @if (Model.OrgImage != null)
                                        {
                                            <img src="@Model.OrgImage.Replace("~", "") " width="100px" height="100px" />
                                        }
                                        <input type="file" name="file" />
                                    </div>


                                    <div>
                                        <input type="submit" value="Update" class="btn btn-lg btn-info btn-block" />
                                    </div>
                                </form>
                            </div>
                        </div>


                    </div>
                </div>
            </div>
        </div>
    </div>

