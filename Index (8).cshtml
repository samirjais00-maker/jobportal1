@model JobPortal.Models.OrganizationViewModel

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}
<link rel="stylesheet" href="/dashboardcontent/assets/css/lib/datatable/dataTables.bootstrap.min.css">
<script src="~/dashboardcontent/assets/js/lib/data-table/datatables.min.js"></script>
<script src="/dashboardcontent/assets/js/lib/data-table/dataTables.bootstrap.min.js"></script>

<div class="breadcrumbs">
    <div class="breadcrumbs-inner">
        <div class="row m-0">
            <div class="col-sm-4">
                <div class="page-header float-left">
                    <div class="page-title">
                        <h1>Dashboard</h1>
                    </div>
                </div>
            </div>
            <div class="col-sm-8">
                <div class="page-header float-right">
                    <div class="page-title">
                        <ol class="breadcrumb text-right">
                            <li><a href="#">Dashboard</a></li>
                            <li><a href="#">Forms</a></li>
                            <li class="active">Basic</li>
                        </ol>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


<div class="content">
    <div class="animated fadeIn">
        <div class="row">

            <div class="col-md-12">
                <div class="card">
                    <div class="card-header">
                        <strong class="card-title">Organisation List</strong>
                        <a asp-action="Create">Create New</a>
                    </div>
                    <div class="card-body">
                        <table id="bootstrap-data-table" class="table table-striped table-bordered">
                            <thead>
                                <tr>
                                    <th>
                                        @Html.DisplayNameFor(model => model.OrgName)
                                    </th>
                                    <th>
                                        @Html.DisplayNameFor(model => model.OrgAddress)
                                    </th>
                                    <th>
                                        @Html.DisplayNameFor(model => model.OrgContact)
                                    </th>
                                    <th>
                                        @Html.DisplayNameFor(model => model.OrgEmail)
                                    </th>
                                    <th>
                                        @Html.DisplayNameFor(model => model.OrgLocation)
                                    </th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.OrganizationList)
                                {
                                    <tr>

                                        <td>
                                            @Html.DisplayFor(modelItem => item.OrgName)
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.OrgAddress)
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.OrgContact)
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.OrgEmail)
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.OrgLocation)
                                        </td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(item.OrgImage))
                                            {
                                                <img src="@item.OrgImage.Replace("~", "")" width="100px" height="100px" />
                                            }
                                            else
                                            {
                                                <span>No image</span>
                                            }
                                        </td>
                                        <td>
                                            @Html.ActionLink("Edit", "Edit", new { id = item.OrgId }) |
                                            @Html.ActionLink("Details", "Details", new { id = item.OrgId }) |
                                            @Html.ActionLink("Delete", "Delete", new { id = item.OrgId })
                                        </td>
                                    </tr>
                                }


                            </tbody>
                        </table>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>
    <script type="text/javascript">
        $(document).ready(function() {
        $('#bootstrap-data-table').DataTable();
        } );
    </script>

